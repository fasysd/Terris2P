MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 950651334}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 15
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<b>1. Shared 15x30 Board:</b> Two players battle concurrently. P1 drops
    from top (-Y), P2 drops from bottom (+Y).\n\n<b>2. Center Barrier:</b> 2 indestructible
    center rows (rows 14-15) always stay filled and prevent crossing.\n\n<b>3. Push
    on Line Clear:</b> When a player clears lines, all blocks (with the barrier)
    are <b>pushed toward the opponent</b> to shrink their placement space!\n\n<b>4.
    Heart Loss & Rebalance:</b>\n   \u2022 When blocks touch edge (P1 touches row
    29, P2 touches row 0) \u2794 <b>Lose 1 Heart!</b>\n   \u2022 Barrier resets to
    center (rows 14-15). Loser's blocks are <b>100% wiped</b>.\n   \u2022 Survivor's
    blocks near barrier are halved (1/2 cleared), remaining blocks pulled tight against
    barrier.\n\n<b>5. Victory:</b> Each player has 3 hearts. First to lose all hearts
    loses the match!"
